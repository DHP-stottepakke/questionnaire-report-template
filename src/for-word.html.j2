<!DOCTYPE HTML>
{# ------------------------------------------------------------------------------------ #}
{#  VARIABLES                                                                           #}
{# ------------------------------------------------------------------------------------ #}
{%- set dc = ctx|to_context_obj -%}
{%- from "src/dates.j2" import formatDate, formatDateTime -%}
{%- from "src/lists.j2" import useTable -%}
{# ------------------------------------------------------------------------------------ #}
{#  TAGS, REFERENCES, and EXPERTS MACROS                                                 #}
{# ------------------------------------------------------------------------------------ #}
{%- macro renderTags(question) -%}
  {% if question.tags|length > 0 %}
    <div data-custom-style="Question Meta">
      <b>{% trans %}Tags:{% endtrans %}</b> {% for tag in question.tags %}<i>{{tag.name}}</i>{% if not loop.last %}, {% endif %}{% endfor %}
    </div>
  {% endif %}
{%- endmacro -%}
{%- macro renderResourcePageReferences(question) -%}
  {% set refs = [] %}
  {% for ref in question.resource_page_references %}
    {% if ref.resource_page_uuid and ref.resource_page and ref.resource_page.collection %}
      {% do refs.append({
        'ref_uuid': ref.uuid,
        'uuid': ref.resource_page_uuid,
        'collection_title': ref.resource_page.collection.title,
        'title': ref.resource_page.title,
      }) %}
    {% endif %}
  {% endfor %}
  {% if refs|length > 0 %}
    <div data-custom-style="Question Meta">
      <b>{% trans %}Resource Pages:{% endtrans %}</b> {% for ref in refs %}{%- set resourcePageLink = dc.config.client_url ~ '/knowledge-models/' ~ dc.km_package.id ~ ':' ~ dc.km_package.version ~ '/resource-pages/' ~ ref.uuid -%}<a id="{{ref.ref_uuid}}" class="reference resourcepage-link" href="{{ resourcePageLink }}"><i>{{ ref.collection_title }} - {{ ref.title }}</i></a>{% if not loop.last %}, {% endif %}{% endfor %}
    </div>
  {% endif %}
{%- endmacro -%}
{%- macro renderURLReferences(question) -%}
  {% set refs = [] %}
  {% for ref in question.url_references %}
    {% if ref.label and ref.url %}
      {% do refs.append({
        'uuid': ref.uuid,
        'label': ref.label,
        'url': ref.url,
      }) %}
    {% endif %}
  {% endfor %}
  {% if refs|length > 0 %}
    <div data-custom-style="Question Meta">
      <b>{% trans %}External Links:{% endtrans %}</b> {% for ref in refs %}<a href="{{ref.url}}" target="_blank"><i>{{ref.label}}</i></a>{% if not loop.last %}, {% endif %}{% endfor %}
    </div>
  {% endif %}
{%- endmacro -%}
{%- macro renderExperts(question) -%}
  {% set experts = [] %}
  {% for expert in question.experts %}
    {% if expert.name and expert.email %}
      {% do experts.append({
        'uuid': expert.uuid,
        'email': expert.email,
        'name': expert.name,
      }) %}
    {% endif %}
  {% endfor %}
  {% if experts|length > 0 %}
    <div data-custom-style="Question Meta">
      <b>{% trans %}Experts:{% endtrans %}</b> {% for expert in experts %}<i>{{expert.name}} (<a href="mailto:{{expert.email}}">{{expert.email}}</a>){% if not loop.last %}, {% endif %}</i>{% endfor %}
    </div>
  {% endif %}
{%- endmacro -%}
{# ------------------------------------------------------------------------------------ #}
{#  ANSWERS MACROS                                                                      #}
{# ------------------------------------------------------------------------------------ #}
{%- macro renderAnswerValue(question, reply, path, humanIdentifier) -%}
  <div data-custom-style="Answer">
    {% if reply is of_type("StringReply") %}
      <p>{{reply.markdown_plain}}</p>
    {% else %}
      {{reply.value.rsplit(" ![]")[0]|markdown}}
      {% if reply.is_legacy_integration %}
        {# Integration #}
        {% set integration = question.integration %}
        <p>
          ({{ integration.name }}: <a href="{{ integration.item(reply.item_id) }}">{{ reply.item_id }}</a>)
        </p>
      {% endif %}
    {% endif %}
  </div>
{%- endmacro -%}
{%- macro renderAnswerOption(question, reply, path, humanIdentifier) -%}
  {% set hi = question.answers.index(reply.answer) %}
  {% set answer = reply.answer %}
  {% set path = path ~ "." ~ answer.uuid %}
  {% set humanIdentifier = humanIdentifier ~ "." ~ hi|of_alphabet %}
  <div>
    <div data-custom-style="Answer">
      <p>{{ hi|of_alphabet }}. {{answer.label}}</p>
    </div>
    {% if answer.advice %}
    <div data-custom-style="Advice">
      <b>{% trans %}Advice:{% endtrans %}</b> {{answer.advice|markdown}}
    </div>
    {% endif %}
    {% if answer.followups|length > 0 %}
      <div>
        {% set hiPrefix = humanIdentifier ~ "." %}
        {% for question in answer.followups %}
          {% set x = loop.index %}
          {{ renderQuestion(question, path, hiPrefix ~ x) }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
{%- endmacro -%}
{%- macro renderAnswerList(question, reply, path, humanIdentifier) -%}
  <div>
    <div data-custom-style="Section Label"><p>{% trans count=reply.items|length %}Answers ({{ count }} item){% pluralize %}Answers ({{ count }} items){% endtrans %}</p></div>
    {% set itemPathPrefix = path ~ "." %}
    {% set hiPrefix = humanIdentifier ~ "." %}
    {% if useTable(question) %}
    <table>
      <colgroup>
        <col style="width: 4%"/>
        {% for fq in question.followups %}<col style="width: {{ 96 / question.followups|length }}%"/>{% endfor %}
      </colgroup>
      <thead>
        <tr>
          <th>#</th>
          {% for fq in question.followups %}
          <th>{{ fq.title }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for itemUuid in reply.items %}
          {% set itemPath = itemPathPrefix ~ itemUuid %}
          <tr>
            <td>{{ loop.index }}</td>
            {% for fq in question.followups %}
              <td>{{ renderAnswerCell(fq, itemPath ~ "." ~ fq.uuid) }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    {% for i in reply.items %}
      {% set itemPath = itemPathPrefix ~ i %}
      {% set itemHumanIdentifier = hiPrefix ~ (loop.index - 1)|of_alphabet %}
      <div class="answer-item" id="{{itemPath}}">
        <div data-custom-style="Item Heading"><p>{{ itemHumanIdentifier }}</p></div>
        <div class="followups">
          {% for question in question.followups %}
            {% set x = loop.index %}
            {{ renderQuestion(question, itemPath, itemHumanIdentifier ~ "." ~ x) }}
          {% else %}
            <div data-custom-style="Not Answered"><p>{% trans %}No follow up questions{% endtrans %}</p></div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div data-custom-style="Not Answered"><p>{% trans %}No answer items{% endtrans %}</p></div>
    {% endfor %}
    {% endif %}
  </div>
{%- endmacro -%}
{%- macro renderCellFollowups(questions, basePath, mode) -%}
{#- lean: answered follow-ups inside a table cell; mode: lines (top level), inline (deeper), item (fields of a list item) #}
{%- for q in questions if q.replies.get(basePath ~ "." ~ q.uuid) and q.replies.get(basePath ~ "." ~ q.uuid).value -%}
{%- if mode == "lines" %}<br/>{% elif mode == "inline" %} — {% elif not loop.first %}; {% else %} {% endif -%}
<i>{{ q.title }}{{ "" if q.title[-1:] in "?:" else ":" }}</i> {{ renderAnswerCell(q, basePath ~ "." ~ q.uuid, false) }}
{%- endfor -%}
{%- endmacro -%}
{%- macro renderAnswerCell(fq, fqPath, top=true) -%}
  {%- set fqReply = fq.replies.get(fqPath) -%}
  {%- if fqReply and fqReply.value -%}
    {%- if fq is of_type("ValueQuestion") and fqReply is of_type("StringReply") -%}
      {{ fqReply.markdown_plain }}
    {%- elif fqReply.is_integration or fqReply.is_legacy_integration -%}
      {{ fqReply.value.rsplit(" ![]")[0]|markdown }}
    {%- elif fq is of_type("OptionsQuestion") and fqReply is of_type("AnswerReply") -%}
      {{ fqReply.answer.label }}
      {{- renderCellFollowups(fqReply.answer.followups, fqPath ~ "." ~ fqReply.answer.uuid, "lines" if top else "inline") -}}
    {%- elif fq is of_type("MultiChoiceQuestion") and fqReply is of_type("MultiChoiceReply") -%}
      {{ fq.choices|select("in", fqReply.choices)|map(attribute="label")|join(", ") }}
    {%- elif fq is of_type("ItemSelectQuestion") and fqReply is of_type("ItemSelectReply") -%}
      {{ fqReply.item_title }}
    {%- elif fq is of_type("FileQuestion") and fqReply is of_type("FileReply") and fqReply.file -%}
      <a href="{{ fqReply.file.download_url }}">{{ fqReply.file.name }}</a>
    {%- elif fq is of_type("ListQuestion") and fqReply is of_type("ItemListReply") -%}
      {%- for itemUuid in fqReply.items -%}
        {%- if not loop.first %}{% if top %}<br/>{% else %} {% endif %}{% endif -%}
        ({{ loop.index }}){{ renderCellFollowups(fq.followups, fqPath ~ "." ~ itemUuid, "item") }}
      {%- endfor -%}
    {%- else -%}
      {{ fqReply.value }}
    {%- endif -%}
  {%- else -%}
    —
  {%- endif -%}
{%- endmacro -%}
{%- macro renderAnswerChoiceList(question, reply, path, humanIdentifier) -%}
  {# lean: only the selected choices, comma-separated #}
  <div data-custom-style="Answer">
    <p>{{ question.choices|select("in", reply.choices)|map(attribute="label")|join(", ") }}</p>
  </div>
{%- endmacro -%}
{%- macro renderAnswerItemSelect(question, reply, path, humanIdentifier) -%}
  <div data-custom-style="Answer">
    <p>{{ reply.item_title }}</p>
  </div>
{%- endmacro -%}
{%- macro renderAnswerFile(question, reply, path, humanIdentifier) -%}
  {% if reply.file %}
  <div data-custom-style="Answer">
    <p><a href="{{ reply.file.download_url }}" target="_blank">{{ reply.file.name }}</a> ({{ reply.file.size|bytesize_format }})</p>
  </div>
  {% else %}
  <div data-custom-style="Not Answered">
    <p>{% trans %}The file has been deleted{% endtrans %}</p>
  </div>
  {% endif %}
{%- endmacro -%}
{# ------------------------------------------------------------------------------------ #}
{#  QUESTION MACROS                                                                     #}
{# ------------------------------------------------------------------------------------ #}
{%- macro renderQuestionExtras(question) -%}
  <div>
    {{ renderResourcePageReferences(question) }}
    {{ renderURLReferences(question) }}
    {{ renderExperts(question) }}
  </div>
{%- endmacro -%}
{%- macro renderQuestionReply(question, path, humanIdentifier) -%}
  {# Question - Answers #}
  {% set reply = question.replies.get(path) %}
  {% if reply and reply.value %}
    {% if question is of_type("ValueQuestion") and reply is of_type("StringReply") %}
      {{ renderAnswerValue(question, reply, path, humanIdentifier) }}
    {% elif question is of_type("OptionsQuestion") and reply is of_type("AnswerReply") %}
      {{ renderAnswerOption(question, reply, path, humanIdentifier) }}
    {% elif question is of_type("ListQuestion") and reply is of_type("ItemListReply") %}
      {{ renderAnswerList(question, reply, path, humanIdentifier) }}
    {% elif question is of_type("IntegrationQuestion") and reply is of_type("IntegrationReply") %}
      {{ renderAnswerValue(question, reply, path, humanIdentifier) }}
    {% elif question is of_type("MultiChoiceQuestion") and reply is of_type("MultiChoiceReply") %}
      {{ renderAnswerChoiceList(question, reply, path, humanIdentifier) }}
    {% elif question is of_type("ItemSelectQuestion") and reply is of_type("ItemSelectReply") %}
      {{ renderAnswerItemSelect(question, reply, path, humanIdentifier) }}
    {% elif question is of_type("FileQuestion") and reply is of_type("FileReply") %}
      {{ renderAnswerFile(question, reply, path, humanIdentifier) }}
    {% endif %}
  {% else %}
    <div data-custom-style="{{ "Not Answered Required" if question.is_required else "Not Answered" }}">
      <p>{% trans %}This question has not been answered yet!{% endtrans %}</p>
    </div>
  {% endif %}
{%- endmacro -%}
{%- macro renderQuestion(question, path, humanIdentifier) -%}
  {% set path = path ~ "." ~ question.uuid %}
  {#- top-level questions are Heading 2, each level of follow-ups one level lower #}
  {% set level = [2 + (humanIdentifier|string).count(".") // 2, 6]|min %}
  <div>
    <h{{ level }}><span data-custom-style="Question Number">{{humanIdentifier}}</span> {{question.title}}</h{{ level }}>

    {{ renderQuestionExtras(question) }}

    {{ renderQuestionReply(question, path, humanIdentifier) }}
  </div>
{%- endmacro -%}
{# ------------------------------------------------------------------------------------ #}
{#  CHAPTER MACROS                                                                      #}
{# ------------------------------------------------------------------------------------ #}
{%- macro renderReport(report, top=false) -%}
  <section>
    {% if top %}
    <h1>{% trans %}Summary{% endtrans %}</h1>
    {% else %}
    <div data-custom-style="Section Label"><p>{% trans %}Summary{% endtrans %}</p></div>
    {% endif %}
    <div data-custom-style="Section Label"><p>{% trans %}Answered indication{% endtrans %}</p></div>
    <table>
      <tbody>
        {% for item in report.indications %}
          <tr>
            <td>{% if item.is_for_phase %}{% trans %}Answered (current phase){% endtrans %}{% else %}{% trans %}Answered{% endtrans %} {% endif %}</td>
            <td>{{item.answered}} / {{item.total}} </td>
            <td>{{ "%.0f"|format(100 * item.percentage) }} %</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if report.metrics|length > 0 %}
    <div data-custom-style="Section Label"><p>{% trans %}Metrics{% endtrans %}</p></div>
    <table>
      <thead><tr><th>{% trans %}Metric{% endtrans %}</th><th>{% trans %}Score{% endtrans %}</th></tr></thead>
      <tbody>
        {% for item in report.metrics %}
          <tr>
            <td>{{ item.metric.title }}</td>
            <td>{{ "%.2f"|format(item.measure) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </section>
{%- endmacro -%}
{%- macro renderChapter(chapter, humanIdentifier) -%}
      <section>
        <h1>{{humanIdentifier|roman}}. {{chapter.title}}</h1>
        {% if chapter.text %}
        <div data-custom-style="Question Text">{{chapter.text|markdown}}</div>
        {% endif %}

        <section>
          {% for question in chapter.questions %}
            {{ renderQuestion(question, chapter.uuid, loop.index) }}
          {% else %}
            <div data-custom-style="Not Answered"><p>{% trans %}No questions{% endtrans %}</p></div>
          {% endfor %}
        </section>
      </section>
{%- endmacro -%}
{# ------------------------------------------------------------------------------------ #}
{#  HTML LAYOUT                                                                         #}
{# ------------------------------------------------------------------------------------ #}
{%- macro renderFrontPage() -%}
  <table>
    {% if dc.project.created_by %}
    <tr>
      <th>{% trans %}Created by{% endtrans %}</th>
      <td>{{dc.project.created_by.first_name}} {{dc.project.created_by.last_name}} (<a href="mailto:{{dc.project.created_by.email}}">{{dc.project.created_by.email}}</a>)</td>
    </tr>
    {% endif %}
    <tr>
      <th>{% trans %}Based on{% endtrans %}</th>
      <td>{{dc.km_package.name}}, {{dc.km_package.version}} (<code>{{dc.km_package.id}}:{{dc.km_package.version}}</code>)</td>
    </tr>
    {% for version in dc.questionnaire.versions if dc.questionnaire.version and version.uuid == dc.questionnaire.version.uuid %}
    <tr>
      <th>{% trans %}Version{% endtrans %}</th>
      <td>{% trans name=version.name, date=formatDateTime(version.created_at) %}{{ name }} ({{ date }} UTC){% endtrans %}</td>
    </tr>
    {% endfor %}
    {% set selectedTags = dc.km.tags|selectattr("uuid", "in", dc.project.selected_question_tag_uuids)|list if dc.project else [] %}
    {% if selectedTags|length > 0 %}
    <tr>
      <th>{% trans %}Selected Tags{% endtrans %}</th>
      <td>{{ selectedTags|map(attribute="name")|join(", ") }}</td>
    </tr>
    {% endif %}
    {% if dc.questionnaire.phase_uuid and dc.questionnaire.phase.uuid == dc.questionnaire.phase_uuid %}
    <tr>
      <th>{% trans %}Project Phase{% endtrans %}</th>
      <td>{{dc.questionnaire.phase.title}}</td>
    </tr>
    {% endif %}
    {% if dc.project.project_tags|length > 0 %}
    <tr>
      <th>{% trans %}Project Tags{% endtrans %}</th>
      <td class="tags-row">{% for tag in dc.project.project_tags %}<span class="tag project-tag">{{ tag }}</span> {% endfor %}</td>
    </tr>
    {% endif %}
    {% if dc.project.description %}
    <tr>
      <th>{% trans %}Description{% endtrans %}</th>
      <td>{{ dc.project.description }}</td>
    </tr>
    {% endif %}
    <tr>
      <th>{% trans %}Created at{% endtrans %}</th>
      <td>{{ formatDate(dc.document.created_at) }}</td>
    </tr>
  </table>

  <div data-custom-style="Tool Info">
    {%- set serviceLink %}<a href="{{ dc.config.client_url }}">{{ dc.config.app_title }}</a>{% endset %}
    <p>{% trans service_name=serviceLink %}Report generated by {{ service_name }}{% endtrans %}</p>
  </div>

  \newpage
{%- endmacro -%}
{%- macro renderVersionsOverview() -%}
  <div>
    <h1>{% trans %}History of Versions{% endtrans %}</h1>
    <p>{% trans %}The named versions of this document:{% endtrans %}</p>
    <table>
      <thead>
        <tr>
          <th>{% trans %}Version{% endtrans %}</th>
          <th>{% trans %}Date{% endtrans %}</th>
          <th>{% trans %}Changes{% endtrans %}</th>
        </tr>
      </thead>
      <tbody>
        {% for version in dc.questionnaire.versions|reverse %}
          <tr>
            <td><strong>{{ version.name }}</strong></td>
            <td>{{ formatDate(version.created_at) }}</td>
            <td>{{ version.description }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{%- endmacro -%}
{%- macro renderContent() -%}
  <div>
    <div>
      {{ renderReport(dc.questionnaire.report.total_report, top=true) }}
    </div>
    {% if dc.questionnaire.versions|length > 0 %}
      {{ renderVersionsOverview() }}
    {% endif %}
    {% for chapter in dc.km.chapters %}
      \newpage
      {{ renderChapter(chapter, loop.index) }}
    {% else %}
      <div data-custom-style="Not Answered"><p>{% trans %}No chapters{% endtrans %}</p></div>
    {% endfor %}

  </div>
{%- endmacro -%}
{# ------------------------------------------------------------------------------------ #}
{#  HTML TEMPLATE                                                                       #}
{# ------------------------------------------------------------------------------------ #}
<html lang="{{ dc.document.locale.code if dc.document.locale else "en" }}">
  <head>
    <title>{{dc.project.name}}</title>
    <meta charset="utf-8">
  </head>
  <body>
      {{ renderFrontPage() }}
      {{ renderContent() }}
  </body>
</html>
